---
import { withBase } from '../utils/urls';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="Pagina niet gevonden" noindex
  ><div class="container not-found">
    <span class="eyebrow">404 · EVEN UIT DE MAAT</span><h1>
      Deze pagina<br />speelt even <span class="text-yellow">niet mee.</span>
    </h1><p>
      Misschien is de link verplaatst. Ga terug naar de homepage en vind jouw
      weg naar de muziek.
    </p><a class="button" href={withBase('/')}
      >Naar de homepage <Icon name="arrow" /></a
    >
  </div></Layout
>
