---
import { withBase } from '../utils/urls';
import type { Teacher } from '../data/teachers';
import Icon from './Icon.astro';
interface Props {
  teacher: Teacher;
}
const { teacher } = Astro.props;
---

<section class="teacher-profile-header">
  <div class="container">
    <nav class="breadcrumb" aria-label="Broodkruimelnavigatie">
      <a href={withBase('/')}>Home</a><Icon name="arrow" size={12} /><a
        href={withBase('/muziekschool/')}>De muziekschool</a
      ><Icon name="arrow" size={12} /><span aria-current="page"
        >{teacher.name}</span
      >
    </nav>
    <div class="teacher-profile-grid">
      <div>
        <span class="eyebrow"
          ><span class="dot"></span> {teacher.specialty.toUpperCase()}</span
        ><h1>{teacher.name}</h1><p>{teacher.intro}</p><a
          class="button"
          href={withBase('/muziekschool/#proefles')}
          >Ontdek jouw muziekles <Icon name="arrow" /></a
        >
      </div><img
        class="teacher-portrait"
        src={withBase(teacher.image)}
        alt={`Portret van ${teacher.name}`}
        width="460"
        height="460"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
<section class="page-content section-padding">
  <div class="container page-introduction">
    <h2>
      Maak kennis met<br /><span class="text-red"
        >{teacher.name.split(' ')[0]}.</span
      >
    </h2><div>
      {teacher.paragraphs.map((p) => <p>{p}</p>)}<p>
        Meer weten over onze muzieklessen en beschikbare lestijden? <a
          class="inline-link"
          href={withBase('/contact/')}>Neem contact op met de muziekschool</a
        >.
      </p><a class="button button-dark" href={withBase('/les-tarieven/')}
        >Bekijk de lestarieven <Icon name="arrow" /></a
      >
    </div>
  </div>
</section>
<section class="related-section">
  <div class="container">
    <h2>Vind de les die bij je past.</h2><a
      class="button button-outline"
      href={withBase('/docenten/')}
      >Alle docentprofielen <Icon name="arrow" /></a
    >
  </div>
</section>
