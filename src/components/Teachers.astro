---
import { withBase } from '../utils/urls';
import { teachers } from '../data/teachers';
import Icon from './Icon.astro';
interface Props {
  all?: boolean;
}
const { all = false } = Astro.props;
const visible = all
  ? teachers
  : teachers.filter((teacher) => teacher.listedOnSchool);
---

<section
  class="teachers-section section-padding"
  aria-labelledby="teachers-title"
>
  <div class="container">
    <div class="section-heading">
      <div>
        <span class="eyebrow"
          ><span class="dot"></span> DE MENSEN ACHTER DE MUZIEK</span
        ><h2 id="teachers-title">
          {all ? 'Docentprofielen.' : 'Onze docenten.'}
        </h2>
      </div><p>
        Iedere muzikant heeft een eigen verhaal. Ontdek hun achtergrond en
        aanpak, en vind de muziekles die bij jou past.
      </p>
    </div>
    <div class="teacher-grid">
      {
        visible.map((teacher) => (
          <a class="teacher-card" href={withBase(`/${teacher.slug}/`)}>
            <>
              <div class="teacher-card-image">
                <>
                  <img
                    src={withBase(teacher.image)}
                    alt={`Portret van ${teacher.name}`}
                    width="460"
                    height="460"
                    loading="lazy"
                    decoding="async"
                  />
                  <span class="round-arrow">
                    <Icon name="arrow" />
                  </span>
                </>
              </div>
              <h3>{teacher.name}</h3>
              <p>{teacher.specialty}</p>
            </>
          </a>
        ))
      }
    </div>
    {
      !all && (
        <a class="text-link" href={withBase('/docenten/')}>
          Bekijk alle docentprofielen <Icon name="arrow" />
        </a>
      )
    }
  </div>
</section>
